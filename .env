# FlowAble Environment Configuration Example
# Copy this file to .env and insert your real credentials.
# NEVER commit your real .env file to Git.

# --- Qdrant Vector Memory Configuration ---
# Your Qdrant Cloud cluster endpoint (e.g. https://xxxx-xxxx.eu-central.aws.cloud.qdrant.io:6333)
QDRANT_URL=https://8ea583ba-768b-4201-bf92-c94de8cedbf4.us-west-1-0.aws.cloud.qdrant.io
# Your Qdrant Cloud API Key
QDRANT_API_KEY=your_qdrant_api_key_here
# Collection name (defaults to flowable_memory)
QDRANT_COLLECTION_NAME=flowable_memory

# --- Lyzr Agent Studio Configuration ---
# Your Lyzr Agent Studio API Key
LYZR_API_KEY=your_lyzr_api_key_here
# Your Lyzr Agent Studio Agent ID
LYZR_AGENT_ID=your_lyzr_agent_id_here
# Lyzr Chat Inference Endpoint (default)
LYZR_CHAT_URL=https://agent-prod.studio.lyzr.ai/v3/inference/chat/

# --- Server Configuration ---
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
